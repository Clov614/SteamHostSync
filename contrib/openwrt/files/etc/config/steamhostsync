config steamhostsync 'main'
	option enabled '0'
	option source 'remote'
	option url 'https://cdn.jsdelivr.net/gh/Clov614/SteamHostSync@main/Hosts'
	option fallback_url 'https://cdn.statically.io/gh/Clov614/SteamHostSync@main/Hosts'
	option allowlist '/etc/steamhostsync/allowed-domains'
	option strict_domains '1'
	option max_bytes '2097152'
	option require_consensus '1'
	option local_binary '/usr/bin/steamhostsync'
	option local_config '/etc/steamhostsync/router-config.yaml'
